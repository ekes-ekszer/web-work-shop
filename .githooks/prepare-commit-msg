#!/usr/bin/env bash

set -euo pipefail

commit_message_file="${1:-}"

if [[ -z "$commit_message_file" || ! -f "$commit_message_file" ]]; then
    exit 0
fi

branch_name="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

if [[ "$branch_name" =~ ^([[:alnum:]_-]+)/([[:alnum:]_-]+)/[0-9]+- ]]; then
    prefix="${BASH_REMATCH[1]}(${BASH_REMATCH[2]}): "
    first_line="$(sed -n '1p' "$commit_message_file")"

    if [[ "$first_line" != "$prefix"* ]]; then
        sed -i "1s|^|$prefix|" "$commit_message_file"
    fi
fi
