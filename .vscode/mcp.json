{
  "inputs": [
    {
      "type": "promptString",
      "id": "figma_access_token",
      "description": "Figma personal access token",
      "password": true
    }
  ],
  "servers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "figma-token": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:figma_access_token}"
      }
    }
  }
}
