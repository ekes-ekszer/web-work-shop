---
import type { Necklace } from '../types/Necklace';
import { media } from '../lib/media';

const initialNecklace: Necklace = {
  ribbon: 'red-ribbon',
  end_band: 'gold-end-band',
  end_pearl: 'gold-pearl',
  end_length_mm: 25,
  rows: [
    {
      pattern: ['red', 'white', 'red'],
      full_length_mm: 40,
    },
  ],
};
---

<section class="customizer" aria-labelledby="customizer-title">
  <nav class="navigation" aria-label="Main navigation">
    <div class="nav-links">
      <a href="/#collection">Shop necklaces</a>
      <a class="active" href="/create">Create your own</a>
      <a href="/">Our story</a>
    </div>
    <a class="brand" href="/">Ékes Ékszer</a>
    <div class="nav-links utility">
      <a href="/#newsletter">Gifts &amp; little gestures</a>
      <img src={media.navigation.search} alt="" />
      <span class="bag"><img src={media.navigation.bag} alt="" />(0)</span>
    </div>
  </nav>

  <div class="heading">
    <p class="eyebrow">Personal by design</p>
    <h1 id="customizer-title">A little piece<br />of you.</h1>
    <p class="intro">
      A name. A memory. A feeling you keep close. Create a necklace that tells
      your story, in your own beautiful way.
    </p>
  </div>

  <div class="workspace">
    <form id="necklace-form" class="menu"></form>
    <aside class="preview" aria-labelledby="preview-title">
      <p class="eyebrow">Share</p>
      <h2 id="preview-title">Your design code</h2>
      <div class="share-panel">
        <h3>Share this design</h3>
        <p id="share-code" class="share-code"></p>
        <div class="share-actions">
          <button type="button" data-action="copy-link">Copy share link</button>
          <button type="button" data-action="copy-code">Copy code</button>
        </div>
        <p id="share-status" class="share-status" role="status"></p>
      </div>
      <pre id="necklace-data" class="data-preview"></pre>
    </aside>
  </div>
</section>

<script define:vars={{ initialNecklace }}>
  const initialize = () => {
    const decodeDesign = (encoded) => {
      try {
        const normalized = encoded.replace(/-/g, '+').replace(/_/g, '/');
        const binary = atob(normalized);
        const bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0));
        const design = JSON.parse(new TextDecoder().decode(bytes));
        const validRibbons = new Set([
          'red-ribbon',
          'burgundy-ribbon',
          'cream-ribbon',
          'blue-ribbon',
          'green-ribbon',
          'rose-ribbon',
          'black-ribbon',
          'purple-ribbon',
        ]);
        const validEndBands = new Set([
          'gold-end-band',
          'silver-end-band',
          'bronze-end-band',
          'rose-gold-band',
          'red-band',
          'blue-band',
          'green-band',
          'black-band',
        ]);
        const validPearls = new Set([
          'red',
          'white',
          'gold',
          'turquoise',
          'pink',
          'green',
          'gold-pearl',
        ]);
        const validStrandPearls = new Set([
          'red',
          'white',
          'gold',
          'turquoise',
          'pink',
          'green',
        ]);
        const isPositiveMeasurement = (value) =>
          typeof value === 'number' && Number.isFinite(value) && value > 0;
        if (
          !Array.isArray(design.rows) ||
          design.rows.length < 1 ||
          design.rows.length > 12 ||
          typeof design.ribbon !== 'string' ||
          typeof design.end_band !== 'string' ||
          typeof design.end_pearl !== 'string' ||
          !validRibbons.has(design.ribbon) ||
          !validEndBands.has(design.end_band) ||
          !validPearls.has(design.end_pearl) ||
          !isPositiveMeasurement(design.end_length_mm) ||
          design.rows.some(
            (row) =>
              !row ||
              typeof row !== 'object' ||
              !isPositiveMeasurement(row.full_length_mm) ||
              !Array.isArray(row.pattern) ||
              row.pattern.length > 100 ||
              row.pattern.some(
                (pearl) => typeof pearl !== 'string' || !validStrandPearls.has(pearl),
              ),
          )
        ) {
          return null;
        }
        return design;
      } catch {
        return null;
      }
    };

    const encodedDesign = new URLSearchParams(location.search).get('design');
    const state = encodedDesign
      ? decodeDesign(encodedDesign) ?? structuredClone(initialNecklace)
      : structuredClone(initialNecklace);
    const form = document.querySelector('#necklace-form');
    const dataPreview = document.querySelector('#necklace-data');
    const shareCode = document.querySelector('#share-code');
    const shareStatus = document.querySelector('#share-status');

    if (!form || !dataPreview || !shareCode || !shareStatus) {
      setTimeout(initialize, 0);
      return;
    }

  const escapeHtml = (value) =>
    String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const encodeDesign = () => {
    const bytes = new TextEncoder().encode(JSON.stringify(state));
    let binary = '';
    bytes.forEach((byte) => {
      binary += String.fromCharCode(byte);
    });
    return btoa(binary)
      .replaceAll('+', '-')
      .replaceAll('/', '_')
      .replace(/=+$/, '');
  };

  const shareUrl = () => {
    const url = new URL(location.href);
    url.search = '';
    url.searchParams.set('design', encodeDesign());
    return url.toString();
  };

  const ribbonOptions = [
    { id: 'red-ribbon', label: 'Heritage red', color: '#9e382f', family: 'red' },
    { id: 'burgundy-ribbon', label: 'Deep burgundy', color: '#672a35', family: 'red' },
    { id: 'cream-ribbon', label: 'Natural cream', color: '#d9c7a6', family: 'gold' },
    { id: 'blue-ribbon', label: 'Folk blue', color: '#4d6680', family: 'blue' },
    { id: 'green-ribbon', label: 'Forest green', color: '#4f6758', family: 'green' },
    { id: 'rose-ribbon', label: 'Muted rose', color: '#a87378', family: 'pink' },
    { id: 'black-ribbon', label: 'Midnight black', color: '#343331', family: 'neutral' },
    { id: 'purple-ribbon', label: 'Heritage purple', color: '#69566f', family: 'purple' },
  ];
  const endBandOptions = [
    { id: 'gold-end-band', label: 'Antique gold', color: '#c9a45d', family: 'gold' },
    { id: 'silver-end-band', label: 'Polished silver', color: '#aeb1ae', family: 'neutral' },
    { id: 'bronze-end-band', label: 'Warm bronze', color: '#a66f46', family: 'brown' },
    { id: 'rose-gold-band', label: 'Rose gold', color: '#b98478', family: 'pink' },
    { id: 'red-band', label: 'Garnet red', color: '#9e382f', family: 'red' },
    { id: 'blue-band', label: 'Patina blue', color: '#4d6680', family: 'blue' },
    { id: 'green-band', label: 'Patina green', color: '#5f7a69', family: 'green' },
    { id: 'black-band', label: 'Darkened steel', color: '#343331', family: 'neutral' },
  ];
  const pearlOptions = [
    { id: 'red', label: 'Red', color: '#b84a3f' },
    { id: 'white', label: 'Ivory', color: '#f1ead8' },
    { id: 'gold', label: 'Gold', color: '#c9a45d' },
    { id: 'turquoise', label: 'Turquoise', color: '#63a9a2' },
    { id: 'pink', label: 'Rose', color: '#d39496' },
    { id: 'green', label: 'Green', color: '#73866a' },
  ];
  let selectedPearl = pearlOptions[0].id;
  let ribbonFilter = 'all';
  let endBandFilter = 'all';
  let editingPearl = null;
  let pearlPopoverPosition = { x: 0, y: 0 };

  const closePearlPopover = (restoreFocus = true) => {
    const previousPearl = editingPearl;
    editingPearl = null;
    render();
    if (restoreFocus && previousPearl) {
      requestAnimationFrame(() => {
        form
          .querySelector(
            `[data-action="replace-pearl"][data-row="${previousPearl.row}"][data-pearl="${previousPearl.pearl}"]`,
          )
          ?.focus();
      });
    }
  };

  const pearlColor = (id) =>
    pearlOptions.find((option) => option.id === id)?.color ?? '#a99d8b';

  const catalogFilters = [
    { id: 'all', label: 'All', color: null },
    { id: 'red', label: 'Red', color: '#9e382f' },
    { id: 'pink', label: 'Pink', color: '#b98478' },
    { id: 'gold', label: 'Gold', color: '#c9a45d' },
    { id: 'green', label: 'Green', color: '#5f7a69' },
    { id: 'blue', label: 'Blue', color: '#4d6680' },
    { id: 'purple', label: 'Purple', color: '#69566f' },
    { id: 'neutral', label: 'Neutral', color: '#343331' },
  ];

  const catalogGallery = (label, path, options, selectedId, activeFilter) => {
    const visibleOptions =
      activeFilter === 'all'
        ? options
        : options.filter((option) => option.family === activeFilter);
    return `
      <section class="catalog-section" aria-label="${escapeHtml(label)}">
        <div class="catalog-heading">
          <span class="field-label">${escapeHtml(label)}</span>
          <span class="catalog-count">${visibleOptions.length} choices</span>
        </div>
        <div class="catalog-filter" aria-label="Filter ${escapeHtml(label)} by color">
          ${catalogFilters
            .map(
              (filter) => `
                <button type="button"
                  class="filter-circle${filter.id === activeFilter ? ' is-selected' : ''}"
                  data-action="filter-catalog" data-catalog="${escapeHtml(path)}" data-filter="${filter.id}"
                  aria-label="Show ${escapeHtml(filter.label)} ${escapeHtml(label).toLowerCase()}"
                  aria-pressed="${filter.id === activeFilter}">
                  ${filter.color
                    ? `<span style="--filter-color: ${filter.color}" aria-hidden="true"></span>`
                    : '<span class="filter-all" aria-hidden="true">All</span>'}
                </button>
              `,
            )
            .join('')}
        </div>
        <div class="catalog-grid">
          ${visibleOptions
            .map(
              (option) => `
                <button type="button"
                  class="catalog-card${option.id === selectedId ? ' is-selected' : ''}"
                  data-action="select-catalog" data-path="${escapeHtml(path)}" data-value="${escapeHtml(option.id)}"
                  aria-pressed="${option.id === selectedId}">
                  <span class="catalog-swatch" style="--catalog-color: ${option.color}" aria-hidden="true"></span>
                  <span>${escapeHtml(option.label)}</span>
                </button>
              `,
            )
            .join('')}
        </div>
      </section>
    `;
  };
  const ribbonColor = (id) =>
    ribbonOptions.find((option) => option.id === id)?.color ?? '#9e382f';

  const numberField = (label, value, path) => `
    <div class="field custom-number-field">
      <span class="field-label">${escapeHtml(label)}</span>
      <div class="number-stepper" data-stepper="${escapeHtml(path)}">
        <button type="button" class="stepper-button" data-action="decrease-number"
          data-path="${escapeHtml(path)}" aria-label="Decrease ${escapeHtml(label)}">
          <span aria-hidden="true">−</span>
        </button>
        <div class="stepper-value" data-path="${escapeHtml(path)}" aria-label="${escapeHtml(label)}">
          <strong>${escapeHtml(value)}</strong>
          <small>mm</small>
        </div>
        <button type="button" class="stepper-button" data-action="increase-number"
          data-path="${escapeHtml(path)}" aria-label="Increase ${escapeHtml(label)}">
          <span aria-hidden="true">+</span>
        </button>
      </div>
    </div>
  `;

  const render = () => {
    form.innerHTML = `
      <section class="customizer-section">
        <header class="section-heading">
          <div><span class="section-number">01</span><h2>Ribbon</h2></div>
        </header>
        ${catalogGallery('Choose ribbon', 'ribbon', ribbonOptions, state.ribbon, ribbonFilter)}
      </section>
      <section class="customizer-section">
        <header class="section-heading">
          <div><span class="section-number">02</span><h2>End band</h2></div>
        </header>
        ${catalogGallery('Choose end band', 'end_band', endBandOptions, state.end_band, endBandFilter)}
      </section>
      <section class="customizer-section">
        <header class="section-heading">
          <div><span class="section-number">03</span><h2>End pearl</h2></div>
        </header>
        ${catalogGallery(
          'Choose end pearl',
          'end_pearl',
          [...pearlOptions, { id: 'gold-pearl', label: 'Gold pearl', color: '#c9a45d', family: 'gold' }],
          state.end_pearl,
          'all',
        )}
      </section>
      <section class="customizer-section">
        <header class="section-heading">
          <div><span class="section-number">04</span><h2>Pearls</h2></div>
        </header>
        <div class="pearl-tool">
          <div class="top-pearl-palette" aria-label="Select the default pearl">
            ${pearlOptions
              .map(
                (pearl) => `
                  <button type="button"
                    class="top-pearl-button${pearl.id === selectedPearl ? ' is-selected' : ''}"
                    data-action="select-pearl" data-value="${pearl.id}"
                    aria-pressed="${pearl.id === selectedPearl}"
                    aria-label="Set default pearl to ${escapeHtml(pearl.label)}">
                    <span class="top-pearl-swatch" style="--pearl-color: ${pearl.color}" aria-hidden="true"></span>
                  </button>
                `,
              )
              .join('')}
          </div>
          <div class="selected-pearl-name" aria-live="polite">
            Default: <strong>${escapeHtml(pearlOptions.find((pearl) => pearl.id === selectedPearl)?.label ?? 'Red')}</strong>
          </div>
        </div>
      </section>
      <section class="customizer-section strands-section">
        <header class="section-heading">
          <div><span class="section-number">05</span><h2>Strands</h2></div>
          <button type="button" class="secondary-button" data-action="add-row">+ Add strand</button>
        </header>
        <div class="measurement-strip">
          ${numberField('End length', state.end_length_mm, 'end_length_mm')}
        </div>
      ${state.rows
        .map(
          (row, rowIndex) => `
            <fieldset class="row">
              <legend>Strand ${rowIndex + 1}</legend>
              ${numberField('Full length (mm)', row.full_length_mm, `rows.${rowIndex}.full_length_mm`)}
              <div class="pearl-editor">
                <div class="sequence-heading">
                  <span class="field-label">Pearl sequence</span>
                  <span class="bead-count">${row.pattern.length} ${row.pattern.length === 1 ? 'bead' : 'beads'}</span>
                </div>
                <div class="pearl-sequence" aria-label="Selected pearls"
                  style="--strand-color: ${ribbonColor(state.ribbon)}">
                  ${row.pattern.length
                    ? row.pattern
                        .map(
                          (pearlId, pearlIndex) => `
                            <button type="button" class="sequence-pearl"
                              style="--pearl-color: ${pearlColor(pearlId)}"
                              title="Change ${escapeHtml(pearlOptions.find((pearl) => pearl.id === pearlId)?.label ?? pearlId)}"
                              aria-label="Change pearl ${pearlIndex + 1}: ${escapeHtml(pearlId)}"
                              aria-haspopup="menu"
                              aria-expanded="${editingPearl?.row === rowIndex && editingPearl?.pearl === pearlIndex}"
                              data-action="replace-pearl" data-row="${rowIndex}" data-pearl="${pearlIndex}">
                            </button>
                          `,
                        )
                        .join('')
                    : '<span class="empty-sequence">Choose pearls below</span>'}
                  <div class="row-pearl-picker">
                    <button type="button" class="sequence-add"
                      data-action="add-selected-pearl" data-row="${rowIndex}"
                      aria-label="Add a pearl to strand ${rowIndex + 1}">
                      +
                    </button>
                  </div>
                </div>
                <p class="hold-hint">Tap a bead to change its pearl color.</p>
                <div class="row-actions">
                  <button type="button" class="row-icon-button" data-action="clear-row" data-row="${rowIndex}"
                    ${row.pattern.length ? '' : 'disabled'}
                    aria-label="Clear strand ${rowIndex + 1} sequence" title="Clear sequence">
                    <span aria-hidden="true">↺</span>
                  </button>
                  ${state.rows.length > 1
                    ? `<button type="button" class="row-icon-button row-remove" data-action="remove-row" data-row="${rowIndex}"
                        aria-label="Remove strand ${rowIndex + 1}" title="Remove strand">
                        <span aria-hidden="true">×</span>
                      </button>`
                    : ''}
                </div>
              </div>
            </fieldset>
          `,
        )
        .join('')}
      </section>
      ${editingPearl
        ? `<div class="pearl-popover" role="menu"
            aria-label="Change pearl ${editingPearl.pearl + 1}"
            style="--popover-x: ${pearlPopoverPosition.x}px; --popover-y: ${pearlPopoverPosition.y}px">
            <div class="popover-heading">
              <span>Pearl ${editingPearl.pearl + 1}</span>
              <button type="button" class="popover-close" data-action="close-pearl-popover"
                aria-label="Close pearl color menu">×</button>
            </div>
            <div class="popover-colors">
              ${pearlOptions
                .map(
                  (pearl) => `
                    <button type="button" role="menuitem"
                      class="row-pearl-option${state.rows[editingPearl.row]?.pattern[editingPearl.pearl] === pearl.id ? ' is-selected' : ''}"
                      data-action="replace-with-pearl" data-row="${editingPearl.row}"
                      data-pearl="${editingPearl.pearl}" data-value="${pearl.id}"
                      aria-pressed="${state.rows[editingPearl.row]?.pattern[editingPearl.pearl] === pearl.id}"
                      aria-label="Change to ${escapeHtml(pearl.label)} pearl">
                      <span class="row-pearl-swatch" style="--pearl-color: ${pearl.color}" aria-hidden="true"></span>
                    </button>
                  `,
                )
                .join('')}
            </div>
          </div>`
        : ''}
    `;

    const code = encodeDesign();
    shareCode.textContent = code;
    history.replaceState(null, '', shareUrl());
    dataPreview.textContent = JSON.stringify(state, null, 2);
  };

  const setValue = (path, value) => {
    const parts = path.split('.');
    let target = state;
    parts.slice(0, -1).forEach((part) => {
      target = target[part];
    });
    const key = parts.at(-1);
    if (key) {
      target[key] =
        key === 'full_length_mm' || key === 'end_length_mm'
          ? Number(value)
          : value;
    }
  };

  const getValue = (path) =>
    path.split('.').reduce((target, part) => target?.[part], state);

  form.addEventListener('click', (event) => {
    const button =
      event.target instanceof HTMLElement ? event.target.closest('button') : null;
    if (!button) return;

    if (button.dataset.action === 'filter-catalog') {
      if (button.dataset.catalog === 'ribbon') ribbonFilter = button.dataset.filter;
      if (button.dataset.catalog === 'end_band') endBandFilter = button.dataset.filter;
      render();
      return;
    }

    if (button.dataset.action === 'select-catalog') {
      setValue(button.dataset.path, button.dataset.value);
      render();
      return;
    }

    if (button.dataset.action === 'increase-number' || button.dataset.action === 'decrease-number') {
      const path = button.dataset.path;
      if (!path) return;
      const current = Number(getValue(path));
      if (!Number.isFinite(current)) return;
      const next = Math.max(1, current + (button.dataset.action === 'increase-number' ? 0.5 : -0.5));
      setValue(path, String(next));
      render();
      return;
    }

    if (button.dataset.action === 'add-row') {
      state.rows.push({ pattern: [], full_length_mm: 40 });
      render();
      return;
    }
    if (button.dataset.action === 'select-pearl') {
      selectedPearl = button.dataset.value;
      render();
      return;
    }
    if (button.dataset.action === 'add-selected-pearl') {
      const rowIndex = Number(button.dataset.row);
      state.rows[rowIndex]?.pattern.push(selectedPearl);
      editingPearl = null;
      render();
      return;
    }
    if (button.dataset.action === 'replace-pearl') {
      const rowIndex = Number(button.dataset.row);
      const pearlIndex = Number(button.dataset.pearl);
      const rect = button.getBoundingClientRect();
      pearlPopoverPosition = {
        x: Math.max(12, Math.min(window.innerWidth - 252, rect.left - 16)),
        y: rect.bottom + 10,
      };
      editingPearl = { row: rowIndex, pearl: pearlIndex };
      render();
      requestAnimationFrame(() => {
        const selectedOption =
          form.querySelector('.pearl-popover [role="menuitem"][aria-pressed="true"]');
        const firstOption =
          selectedOption ?? form.querySelector('.pearl-popover [role="menuitem"]');
        firstOption?.focus();
      });
      return;
    }
    if (button.dataset.action === 'replace-with-pearl') {
      const rowIndex = Number(button.dataset.row);
      const pearlIndex = Number(button.dataset.pearl);
      if (state.rows[rowIndex]) {
        state.rows[rowIndex].pattern[pearlIndex] = button.dataset.value;
      }
      closePearlPopover();
      return;
    }
    if (button.dataset.action === 'close-pearl-popover') {
      closePearlPopover();
      return;
    }
    if (button.dataset.action === 'clear-row') {
      const rowIndex = Number(button.dataset.row);
      if (state.rows[rowIndex]) state.rows[rowIndex].pattern = [];
      render();
      return;
    }
    if (button.dataset.action === 'remove-row') {
      const rowIndex = Number(button.dataset.row);
      state.rows.splice(rowIndex, 1);
      render();
      return;
    }
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof HTMLElement)) return;
    if (
      editingPearl &&
      !event.target.closest('.pearl-popover') &&
      !event.target.closest('[data-action="replace-pearl"]')
    ) {
      closePearlPopover();
    }

    const copyButton = event.target.closest('[data-action="copy-link"], [data-action="copy-code"]');
    if (!(copyButton instanceof HTMLButtonElement)) return;
    const value = copyButton.dataset.action === 'copy-link' ? shareUrl() : encodeDesign();
    if (!navigator.clipboard) {
      shareCode.classList.add('is-visible');
      shareStatus.textContent = 'Copy is unavailable. Select the code below and copy it manually.';
      return;
    }
    navigator.clipboard.writeText(value).then(
      () => {
        shareStatus.textContent =
          copyButton.dataset.action === 'copy-link'
            ? 'Share link copied.'
            : 'Design code copied.';
      },
      () => {
        shareCode.classList.add('is-visible');
        shareStatus.textContent = 'Copy failed. Select the code below and copy it manually.';
      },
    );
  });

  document.addEventListener('keydown', (event) => {
    if (editingPearl && event.target instanceof HTMLElement) {
      const popover = event.target.closest('.pearl-popover');
      const menuItem = event.target.closest('[role="menuitem"]');
      if (popover && menuItem) {
        const options = [...popover.querySelectorAll('[role="menuitem"]')];
        const currentIndex = options.indexOf(menuItem);
        let nextIndex = currentIndex;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = (currentIndex + 1) % options.length;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = (currentIndex - 1 + options.length) % options.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = options.length - 1;
        }
        if (nextIndex !== currentIndex) {
          event.preventDefault();
          options[nextIndex]?.focus();
        }
      }
    }
    if (event.key !== 'Escape') return;
    if (editingPearl) {
      closePearlPopover();
    }
  });

    render();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }

  .customizer {
    width: 100%;
    margin: 0 auto;
