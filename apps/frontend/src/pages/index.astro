---
import Layout from '../layouts/Layout.astro';
import { media } from '../lib/media';
---

<Layout>
  <main class="story-page">
    <nav class="navigation" aria-label="Main navigation">
      <div class="nav-links">
        <a href="/#collection">Shop necklaces</a>
        <a href="/create">Create your own</a>
        <a class="active" href="/">Our story</a>
      </div>
      <a class="wordmark" href="/">Ékes Ékszer</a>
      <div class="utility-links">
        <a href="#newsletter">Gifts &amp; little gestures</a>
        <img src={media.navigation.search} alt="" />
        <span class="bag"><img src={media.navigation.bag} alt="" />(0)</span>
      </div>
    </nav>

    <section class="intro">
      <div class="intro-copy">
        <p class="eyebrow">Our story</p>
        <h1>Worn with<br />heritage.<br />Kept with heart.</h1>
        <p>Traditional Hungarian necklaces are meant to be worn with intention. We honor that spirit with bold motifs, rich textures, and pieces designed to feel timeless, personal, and quietly beautiful.</p>
        <div class="signature"><span></span>Worn with heritage. Kept with heart.</div>
      </div>
      <img class="intro-image" src={media.story.hero} alt="Traditional Hungarian beaded necklaces" />
    </section>

    <section class="values">
      <p class="eyebrow">The Ékes way</p>
      <h2>Worn with intention.<br />Kept with heart.</h2>
      <div class="value-grid">
        <article><img src={media.story.values.heritage} alt="" /><h3>Rooted in heritage.</h3><p>We draw inspiration from traditional Hungarian motifs, then shape them into pieces that feel modern, personal, and quietly meaningful.</p></article>
        <article><img src={media.story.values.bold} alt="" /><h3>Bold, yet effortless.</h3><p>Traditional Hungarian necklaces are often bold and expressive. We translate that spirit into modern silhouettes that feel confident, elegant, and easy to wear.</p></article>
        <article><img src={media.story.values.care} alt="" /><h3>Finished with care.</h3><p>Every necklace is shaped to feel balanced, elegant, and quietly meaningful — so you can wear it with confidence and keep it close for years to come.</p></article>
      </div>
    </section>

    <section class="invitation">
      <div>
        <p class="eyebrow">Your story starts here</p>
        <h2>Create a necklace<br />with heritage.</h2>
        <p>Start with a piece you love. Make it personal. Keep it close.</p>
        <div class="actions"><a class="button" href="/create">Create your necklace <span>→</span></a><a href="/create">Shop all necklaces</a></div>
      </div>
      <img src={media.story.cta} alt="Hungarian beaded necklaces on fabric" />
    </section>

    <section id="newsletter" class="newsletter">
      <div><p class="eyebrow">A note from Ékes</p><h2>Good things, kept close.</h2><p>New pieces, little inspirations, and 10% off your first order.</p></div>
      <div class="email">Your email address <span>→</span><small>Only thoughtful things. Unsubscribe whenever you like.</small></div>
    </section>
    <footer><div><strong>Ékes Ékszer</strong><p>Jewelry for the things that make you, you.<br />Made personal. Worn close.</p></div><div><b>Discover</b><a href="/create">Create your own</a><a href="#collection">All necklaces</a><a href="/">Our story</a></div><div><b>A little help</b><a href="#newsletter">Care guide</a><a href="#newsletter">Find your length</a><a href="mailto:ekes.ekszer@gmail.com">Contact us</a></div><div><b>Find us</b><a href="#newsletter">Instagram</a><a href="mailto:ekes.ekszer@gmail.com">ekes.ekszer@gmail.com</a></div><div class="legal"><span>© 2026 Ékes Ékszer. All the little things, treasured.</span><span>Privacy　·　Terms　·　Accessibility</span><span>Romania / RON　↓</span></div></footer>
  </main>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  .story-page { background: #f4ece2; color: #332d27; font-family: Inter, Arial, sans-serif; }
  .navigation { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 94px; padding: 0 5vw; border-bottom: 1px solid #cdbfa8; }
  .nav-links, .utility-links { display: flex; align-items: center; gap: 28px; font-size: 12px; }
  .nav-links a, .utility-links a { color: #332d27; text-decoration: none; }
  .nav-links .active { color: #886c42; text-decoration: underline; text-underline-offset: 3px; }
  .wordmark { color: #332d27; font: 43px Georgia, serif; text-decoration: none; }
  .utility-links { justify-content: flex-end; gap: 26px; }
  .utility-links > img, .bag img { width: 19px; height: 19px; }
  .bag { display: flex; align-items: center; gap: 8px; }
  .intro { display: grid; grid-template-columns: 45.1% 54.9%; height: 650px; }
  .intro-copy { display: flex; flex-direction: column; justify-content: center; gap: 28px; padding: 94px 11.4% 94px 5vw; }
  .intro-copy h1 { margin: 0; font: 76px/1.08 Georgia, serif; }
  .intro-copy > p:not(.eyebrow) { margin: 0; color: #766d62; font-size: 15px; line-height: 1.8; }
  .intro-image { width: 100%; height: 539px; margin-top: 71px; object-fit: cover; }
  .eyebrow { margin: 0; color: #886c42; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .signature { display: flex; align-items: center; gap: 18px; padding-top: 28px; color: #766d62; font-size: 11px; }
  .signature span { width: 42px; height: 1px; background: #886c42; }
  .values { padding: 88px 5vw; }
  h2 { margin: 18px 0 40px; font: 56px/1.08 Georgia, serif; }
  .value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .value-grid article { padding-top: 26px; border-top: 1px solid #dcd3c6; }
  .value-grid img { width: 26px; height: 26px; margin-bottom: 20px; }
  .value-grid h3 { margin: 0; font: 32px/1.1 Georgia, serif; }
  .value-grid p, .invitation p, .newsletter p, footer p { color: #766d62; font-size: 13px; line-height: 1.8; }
  .invitation { display: grid; grid-template-columns: 50.35% 49.65%; min-height: 392px; background: #3a342f; color: #f8f5ef; }
  .invitation > div { display: flex; flex-direction: column; justify-content: center; padding: 54px 17% 54px 5vw; }
  .invitation h2 { margin: 22px 0; color: #f8f5ef; }
  .invitation p { margin: 0; color: #e4dacc; }
  .invitation > img { width: 100%; height: 392px; object-fit: cover; }
  .actions { display: flex; align-items: center; gap: 28px; padding-top: 20px; font-size: 13px; }
  .actions a:last-child { color: #f8f5ef; text-decoration: underline; text-underline-offset: 3px; }
  .button { display: inline-flex; gap: 24px; align-items: center; padding: 17px 26px; background: #886c42; color: white; text-decoration: none; }
  .newsletter { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; padding: 64px 5vw 42px; background: #efe4d7; }
  .newsletter h2 { margin: 14px 0; font-size: 44px; }
  .email { align-self: center; padding: 18px 0; border-bottom: 1px solid #886c42; color: #766d62; font-size: 12px; }
  .email span { float: right; color: #886c42; font-size: 20px; }
  .email small { display: block; margin-top: 12px; font-size: 10px; }
  footer { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 30px; padding: 28px 5vw; background: #efe4d7; border-top: 1px solid #cdbfa8; }
  footer strong { font: 33px Georgia, serif; }
  footer p { margin-top: 16px; }
  footer b { display: block; margin-bottom: 15px; font-size: 11px; }
  footer a { display: block; margin-bottom: 12px; color: #766d62; font-size: 12px; text-decoration: none; }
  .legal { grid-column: 1 / -1; display: flex; justify-content: space-between; padding-top: 28px; border-top: 1px solid #cdbfa8; color: #766d62; font-size: 10px; }
  @media (max-width: 760px) {
    .navigation { grid-template-columns: 1fr auto; height: auto; padding: 20px 16px; }
    .nav-links { display: none; }
    .wordmark { grid-column: 1; font-size: 34px; }
    .utility-links { grid-column: 2; gap: 12px; }
    .utility-links a, .utility-links > img { display: none; }
    .intro, .invitation, .newsletter { grid-template-columns: 1fr; height: auto; }
    .intro-copy { min-height: 520px; padding: 60px 24px; }
    .intro-copy h1 { font-size: 56px; }
    .intro-image { height: 360px; margin: 0; }
    .values { padding: 60px 24px; }
    h2 { font-size: 43px; }
    .value-grid { grid-template-columns: 1fr; gap: 30px; }
    .invitation > div { padding: 60px 24px; }
    .invitation > img { height: 300px; }
    .newsletter { gap: 30px; padding: 56px 24px 30px; }
    footer { grid-template-columns: 1fr 1fr; padding: 28px 24px; }
    .legal { grid-column: 1 / -1; display: grid; gap: 12px; }
  }
</style>
